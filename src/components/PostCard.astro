---
import type { PostItem } from "@/lib/types";
import MediaBlock from "./MediaBlock.astro";
interface Props { post: PostItem }
const { post } = Astro.props;
---
<article class="post-card" data-category={post.category}>
  <MediaBlock image={post.image} />
  <div class="card-topline">
    <span>{post.date}</span>
    <span>{post.category}</span>
  </div>
  <h3>{post.title}</h3>
  <p>{post.summary}</p>
  {
    post.url && (
      <a class="text-link" href={post.url} target="_blank" rel="noreferrer">
        View LinkedIn post
      </a>
    )
  }
</article>
