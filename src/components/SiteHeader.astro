---
import { navItems, navHref, isActivePath } from "@/lib/site";
import { profile } from "@/data/profile";
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={navHref("/")} aria-label="Jaiwanth Karthi home">
      <span class="brand-mark">{profile.shortName}</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span>Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={navHref(item.href)}
            class:list={["nav-link", { active: isActivePath(currentPath, item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.querySelector("#site-nav");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    nav?.classList.toggle("open", !expanded);
  });
</script>
