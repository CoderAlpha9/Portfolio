---
import type { ExperienceItem } from "@/lib/types";
import TagList from "./TagList.astro";
import ResourceLinks from "./ResourceLinks.astro";
import MediaBlock from "./MediaBlock.astro";
interface Props { item: ExperienceItem }
const { item } = Astro.props;
---
<article class="timeline-entry">
  <div class="timeline-date">
    <span>{item.period}</span>
  </div>
  <div class="timeline-content">
    <p class="kicker">{item.organisation}</p>
    <h3>{item.title}</h3>
    <ul class="clean-list">
      {item.description.map((line) => <li>{line}</li>)}
    </ul>
    <TagList items={item.tags} />
    <MediaBlock image={item.image} />
    <ResourceLinks links={item.links} />
  </div>
</article>
