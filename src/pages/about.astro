---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { profile } from "@/data/profile";

const contactEntries = [
  { label: "LinkedIn", value: profile.contacts.linkedin, href: profile.contacts.linkedin },
  { label: "GitHub", value: profile.contacts.github, href: profile.contacts.github },
  { label: "Email", value: profile.contacts.email, href: profile.contacts.email ? `mailto:${profile.contacts.email}` : "" },
  { label: "Phone", value: profile.contacts.phone, href: profile.contacts.phone ? `tel:${profile.contacts.phone.replace(/\s/g, "")}` : "" }
].filter((item) => item.value);
---
<BaseLayout
  title="About | Jaiwanth Karthi"
  description="Background, education, technical focus and contact details for Jaiwanth Karthi."
>
  <PageHero
    eyebrow="About"
    title="I like building AI systems that hold up outside a demo."
    intro="My work is primarily in machine learning and deep learning, supported by software systems, data engineering and full-stack development."
  />

  <section class="section shell two-column">
    <div class="section-label">Details</div>
    <div class="prose-stack">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section shell two-column">
    <div class="section-label">Technical focus</div>
    <div class="skill-grid">
      {profile.skills.map((group) => (
        <article class="skill-group">
          <h3>{group.title}</h3>
          <div class="skill-pills">
            {group.items.map((item) => <span>{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell two-column">
    <div class="section-label">Education</div>
    <div class="education-list">
      {profile.education.map((item) => (
        <article>
          <div class="card-topline">
            <span>{item.period}</span>
          </div>
          <h3>{item.institution}</h3>
          <p class="education-programme">{item.programme}</p>
          <p>{item.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell two-column" id="contact">
    <div class="section-label">Contact</div>
    <div>
      <p class="contact-intro">
        The best way to reach me for technical work, research conversations or collaboration is through the links below.
      </p>
      <div class="contact-grid">
        {contactEntries.map((item) => (
          <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
