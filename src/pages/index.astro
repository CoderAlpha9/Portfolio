---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
import NeuralGraph from "@/components/home/NeuralGraph.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";
import { achievements } from "@/data/achievements";
import { experience } from "@/data/experience";

const featuredProjects = [...projects]
  .filter((project) => project.featured)
  .sort((a, b) => (a.priority ?? 99) - (b.priority ?? 99))
  .slice(0, 4);

const featuredAchievements = achievements
  .filter((item) => item.group === "Major")
  .slice(0, 4);

const selectedExperience = experience
  .filter((item) => item.type === "Professional")
  .slice(0, 2);
---
<BaseLayout>
  <section class="home-hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{profile.eyebrow}</p>
      <h1>{profile.headline}</h1>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href={withBase("/projects/")}>View projects</a>
        <a class="button secondary" href={withBase("/about/")}>About me</a>
      </div>
      <div class="hero-links">
        <a href={profile.contacts.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href={profile.contacts.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </div>
    </div>
    <NeuralGraph />
  </section>

  <section class="credibility shell" aria-label="Selected highlights">
    {featuredAchievements.map((item) => (
      <div class="credibility-item">
        <span>{item.issuer}</span>
        <strong>{item.highlight ?? item.title}</strong>
      </div>
    ))}
  </section>

  <section class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Focus</p>
      <h2>Building around intelligence, systems and useful products.</h2>
      <p>
        The portfolio is organised around the areas I spend most of my time on. Machine learning comes first,
        followed by the software and data systems needed to make it useful.
      </p>
    </div>

    <div class="focus-grid">
      {profile.focus.map((item, index) => (
        <article class:list={["focus-card", { primary: index === 0 }]}>
          <span class="index">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading horizontal">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Projects with depth.</h2>
      </div>
      <a class="text-link" href={withBase("/projects/")}>View all projects</a>
    </div>
    <div class="project-grid featured-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Experience</p>
      <h2>Work that connects modelling with implementation.</h2>
    </div>
    <div class="home-experience-grid">
      {selectedExperience.map((item) => (
        <article class="home-experience">
          <span>{item.period}</span>
          <p class="kicker">{item.organisation}</p>
          <h3>{item.title}</h3>
          <p>{item.description[0]}</p>
        </article>
      ))}
      <article class="home-experience home-experience-cta">
        <p class="kicker">Beyond internships</p>
        <h3>Technical leadership and campus projects</h3>
        <p>Explore NanoCompile, Gesturize, Programming Club, AI Club and other responsibilities.</p>
        <a class="text-link" href={withBase("/experience/")}>View experience</a>
      </article>
    </div>
  </section>

  <section class="section shell closing-cta">
    <p class="eyebrow">Explore</p>
    <h2>Looking for the technical details?</h2>
    <p>
      Start with Projects for implementation depth, or About for the wider context behind my work.
    </p>
    <div class="hero-actions">
      <a class="button primary" href={withBase("/projects/")}>Projects</a>
      <a class="button secondary" href={withBase("/about/")}>About</a>
    </div>
  </section>
</BaseLayout>
