---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PostCard from "@/components/PostCard.astro";
import { posts } from "@/data/posts";

const categories = ["All", ...Array.from(new Set(posts.map((post) => post.category)))];
---
<BaseLayout
  title="Posts | Jaiwanth Karthi"
  description="Selected LinkedIn posts and short technical updates across AI, software, projects and competitions."
>
  <PageHero
    eyebrow="Posts"
    title="Short notes from the work around the work."
    intro="A lightweight index of selected LinkedIn updates. Each card keeps the context brief and links out when a direct post URL is available."
  />

  <section class="section shell">
    <div class="filter-bar" aria-label="Post filters">
      {categories.map((category, index) => (
        <button class:list={["filter-button", { active: index === 0 }]} type="button" data-post-filter={category}>
          {category}
        </button>
      ))}
    </div>

    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-post-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.postFilter ?? "All";
        buttons.forEach((item) => item.classList.toggle("active", item === button));
        cards.forEach((card) => {
          const visible = filter === "All" || card.dataset.category === filter;
          card.toggleAttribute("hidden", !visible);
        });
      });
    });
  </script>
</BaseLayout>
